{
  "name": "india-book-centre-desktop",
  "productName": "India Book Centre LMS",
  "version": "1.0.0",
  "description": "Enterprise Multi-School Book Allocation, Kit Dispatch & Student Billing Desktop Software",
  "main": "main.js",
  "author": "India Book Centre",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.indiabookcentre.lms",
    "productName": "India Book Centre LMS",
    "directories": {
      "output": "dist-build"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/data/*.db",
          "!**/data/*.db-journal"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "India Book House LMS"
    }
  }
}
