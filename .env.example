# ===============================================
# India Book Centre LMS - Environment Variables
# ===============================================

# Brand Name (If omitted or empty, the application displays 'N/A')
VITE_APP_NAME="India Book Centre"
VITE_APP_SHORT_NAME="IBC"
APP_NAME="India Book Centre"

# Port to expose
PORT=5000

# Node Environment
NODE_ENV=production

# JWT Authentication Secret Key (Change this to a strong random string)
JWT_SECRET=ibh-super-secret-jwt-key-change-me-in-production-2026
