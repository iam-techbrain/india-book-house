# ==========================================
# India Book House - Git Ignore Configuration
# ==========================================

# Dependencies (Node.js)
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
 
# Production Build Artifacts
dist/
dist-ssr/
frontend/dist/
build/
*.tsbuildinfo

# Electron Desktop App Builds & Executables
*.exe
*.msi
*.dmg
*.pkg
*.appimage
*.deb
*.rpm
*.blockmap
desktop-app/node_modules/
desktop-app/dist-*/
dist-installer/
dist-build/
dist-electron/
win-unpacked/

# SQLite Database & Storage (Prevent accidental commit of DB files)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Environment Variables & Private Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# Runtime & Process Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Code Editor Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Testing & Coverage
coverage/
.nyc_output/

# Temporary / Scratch Files
tmp/
temp/
*.tmp
